# ===========================================
# PORTFOLIO WEBSITE - ENVIRONMENT CONFIG
# ===========================================
# Copy this file to .env and fill in your values
# For deployment, update these values accordingly

# ========================
# SERVER CONFIG
# ========================
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com

# ========================
# MONGODB CONFIG
# ========================
# For local: mongodb://127.0.0.1:27017/portfolio_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio_db
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# ========================
# ADMIN CONFIG
# ========================
# Change these for production deployment!
ADMIN_EMAIL=helloashutosh1@outlook.com
ADMIN_PASSWORD=admin123
JWT_SECRET=your_secret_here

# ========================
# EMAIL/SMTP CONFIG
# ========================
# For production, configure your SMTP settings
# Gmail: Use App Password (not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# ========================
# YOUR EMAIL (for receiving notifications)
# ========================
OWNER_EMAIL=helloashutosh1@outlook.com

# ========================
# CORS (for production)
# ========================
# For production, restrict to your domain:
# ALLOWED_ORIGIN=https://yourdomain.com
# Comma-separated list of allowed origins (Vercel domain, custom domain)
ALLOWED_ORIGIN=https://your-frontend.vercel.app,https://yourdomain.com

# ========================
# DEPLOYMENT NOTES
# ========================
# 1. Set MONGODB_URI to your MongoDB Atlas connection string
# 2. Update ADMIN_EMAIL and ADMIN_PASSWORD for security
# 3. Configure SMTP settings for email notifications
# 4. Set ALLOWED_ORIGIN to your production domain
# 5. Update frontend/index.html meta tags for SEO
